{
  "name": "node-package",
  "version": "0.0.1",
  "description": "A boilerplate node-package for writing reusable package for services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=verbose",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@dhruv-m-patel/eslint-config-core": "workspace:^",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
