{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "baseUrl": "./",
    "outDir": "./build",
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node", "jest"]
  },
  "include": ["./src"],
  "exclude": ["./tests", "node_modules"]
}
