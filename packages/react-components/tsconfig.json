{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react",
    "outDir": "build/esm",
    "rootDir": "./src",
    "noImplicitAny": false,
    "types": ["node", "jest"]
  },
  "include": ["./src"],
  "exclude": [
    "node_modules",
    "./build",
    "./src/setupTests.ts",
    "./src/**/*.test.tsx"
  ]
}
