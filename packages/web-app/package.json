{
  "name": "@dhruv-m-patel/web-app",
  "version": "1.8.0",
  "description": "Express SSR scaffolding for Vite-powered React apps. Drop-in replacement for the legacy Webpack 4 web-app package.",
  "type": "module",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "rimraf ./build && yarn build:cjs && yarn build:esm && node -e \"require('fs').writeFileSync('build/cjs/package.json', JSON.stringify({type:'commonjs'}))\" && node -e \"require('fs').writeFileSync('build/esm/package.json', JSON.stringify({type:'module'}))\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhruv-m-patel/packages.git",
    "directory": "packages/web-app"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express-enrouten": "^1.3.0",
    "express-session": "^1.18.1",
    "morgan": "^1.10.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@dhruv-m-patel/eslint-config-core": "workspace:^",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "express": "^4.21.2",
    "rimraf": "^5.0.10",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "express": ">= 4",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
